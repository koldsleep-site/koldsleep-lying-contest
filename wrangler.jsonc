{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koldsleep-lying-contest",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
{
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
